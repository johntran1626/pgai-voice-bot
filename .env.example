# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub (it's already in .gitignore).

# From your Vapi.ai dashboard -> API Keys
VAPI_API_KEY=

# From your Vapi.ai dashboard -> Phone Numbers (the Twilio number you connected)
# This is the number your bot calls FROM.
VAPI_PHONE_NUMBER_ID=

# The only number your bot is allowed to call TO for this assessment.
TARGET_PHONE_NUMBER=+18054398008

# Anthropic API key, used as the "brain" for your patient persona,
# and (optionally) to help draft the bug report from transcripts.
ANTHROPIC_API_KEY=

# Which LLM Vapi should use to run the persona during the call.
# Check Vapi's dashboard (Assistants -> Model -> Anthropic) for the exact
# current model string they support -- this changes over time.
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-5

# Voice used for your bot's spoken side of the call.
# See https://docs.vapi.ai/providers/voice for options.
VOICE_PROVIDER=11labs
VOICE_ID=paula
