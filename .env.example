# ---------------------------------------------------------------------------
# Copy this file to ".env" and paste your real values in.
#   cp .env.example .env
# The real .env is in .gitignore and must NEVER be committed to GitHub.
# ---------------------------------------------------------------------------

# --- OpenAI -----------------------------------------------------------------
# From https://platform.openai.com/api-keys  (starts with "sk-")
# Required: the Realtime API holds the call. Also used for the analysis
# unless ANTHROPIC_API_KEY is set below.
OPENAI_API_KEY=

# The speech-to-speech model that plays our patient. Leave as-is unless
# OpenAI renames it.
REALTIME_MODEL=gpt-realtime

# Which voice our fake patient speaks with.
# Options include: alloy, ash, ballad, coral, echo, sage, shimmer, verse, cedar, marin
PATIENT_VOICE=coral

# --- Bug analysis (text only — NOT the live call) ---------------------------
# The live phone call REQUIRES OpenAI: Anthropic has no realtime
# speech-to-speech API. But reading transcripts is plain text work, so you can
# run that half on Anthropic credits instead.
#
# auto      = use Anthropic if ANTHROPIC_API_KEY is set, else OpenAI  (default)
# anthropic = force Claude
# openai    = force OpenAI
ANALYSIS_PROVIDER=auto

# From https://console.anthropic.com/settings/keys  (starts with "sk-ant-")
# Optional. Leave blank to do the analysis on OpenAI instead.
# Note: a Claude Pro/Max subscription is NOT API credit — these are separate
# balances, and this needs console credit.
ANTHROPIC_API_KEY=

# Which model each provider uses for the analysis.
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
ANALYSIS_MODEL=gpt-5

# --- Turn-taking (tune this by listening to a recording) --------------------
# Trades reply SPEED against INTERRUPTIONS. No value wins both.
#   VAD_MODE=semantic + VAD_EAGERNESS=low     politest, slowest to reply
#   VAD_MODE=semantic + VAD_EAGERNESS=medium  balanced (default)
#   VAD_MODE=server   + VAD_SILENCE_MS=700    snappiest, may cut into pauses
VAD_MODE=semantic
VAD_EAGERNESS=medium
VAD_SILENCE_MS=700

# --- Twilio -----------------------------------------------------------------
# From https://console.twilio.com  (Account Info panel on the dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio phone number YOU bought, in E.164 format, e.g. +14155550123.
# IMPORTANT: use one number for every call so results stay comparable.
TWILIO_FROM_NUMBER=

# --- The number under test --------------------------------------------------
# Also hardcoded in config.py; the code refuses to dial anything else.
TARGET_NUMBER=+18054398008

# --- Networking -------------------------------------------------------------
# Local port the audio bridge listens on. Change only if 5050 is in use.
PORT=5050

# Which service opens that public door.
#   auto        = ngrok if NGROK_AUTHTOKEN is set below, else cloudflared
#   ngrok       = force ngrok
#   cloudflared = force a Cloudflare quick tunnel (no account, no token;
#                 needs `brew install cloudflared`)
#
# Try `auto` first. If check_setup.py reports "your network is blocking
# ngrok", set this to cloudflared — plenty of home routers and ISPs treat
# ngrok subdomains as high-risk and block them.
TUNNEL_PROVIDER=auto

# From https://dashboard.ngrok.com/get-started/your-authtoken
# Opens a public URL routing to this process so Twilio can stream call
# audio to it. Not needed if TUNNEL_PROVIDER=cloudflared.
NGROK_AUTHTOKEN=

# OPTIONAL: if you already have your own public HTTPS host (e.g. you deployed
# this somewhere, or you run `ngrok http 5050` yourself in another terminal),
# put the bare hostname here and ngrok will NOT be auto-started.
# Example: PUBLIC_HOST=abcd-1-2-3-4.ngrok-free.app
PUBLIC_HOST=

# --- Call behaviour ---------------------------------------------------------
# Hard stop so a stuck call can never bill you forever (seconds).
MAX_CALL_SECONDS=300
